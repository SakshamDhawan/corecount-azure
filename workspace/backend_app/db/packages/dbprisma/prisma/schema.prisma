generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../src/generated"
  createOptionalDefaultValuesTypes = "true"
  writeNullishInModelTypes         = "true"
  createPartialTypes               = "true"
  createRelationValuesTypes        = "true"
  useTypeAssertions                = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    String @id @default(cuid())
  email String @unique
  hash  String
  name  String
  role  Role
  salt  String

  programme          Programme[]
  completedWorkouts  CompletedWorkout[]
  completedProgramme CompletedProgramme[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  Reminder  Reminder[]
}

model Workout {
  id          String       @id @default(cuid())
  title       String       @unique
  description String
  difficulty  Difficulty   @default(EASY)
  hold_1      Int
  hold_2      Int
  hold_3      Int
  content     String
  video       String?
  level       WorkoutLevel @default(BASIC)
  sensors     Sensors[]

  programmes        WorkoutsOnProgrammes[]
  completedWorkouts CompletedWorkout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Reminder Reminder[]
}

model CompletedWorkout {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  workout   Workout @relation(fields: [workoutId], references: [id])
  workoutId String

  points   Int @default(0)
  duration Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  completedProgramme   CompletedProgramme? @relation(fields: [completedProgrammeId], references: [id])
  completedProgrammeId String?
}

model Programme {
  id String @id @default(cuid())

  name   String
  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  workouts            WorkoutsOnProgrammes[]
  completedProgrammes CompletedProgramme[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  reminders Reminder[]
}

model CompletedProgramme {
  id String @id @default(cuid())

  programme   Programme @relation(fields: [programmeId], references: [id])
  programmeId String
  user        User      @relation(fields: [userId], references: [id])
  userId      String

  workouts CompletedWorkout[]

  completed Boolean @default(false)

  strength Int @default(1)
  reps     Int @default(6)

  rating   Int     @default(1)
  comments String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model WorkoutsOnProgrammes {
  programme   Programme @relation(fields: [programmeId], references: [id])
  programmeId String
  workout     Workout   @relation(fields: [workoutId], references: [id])
  workoutId   String

  order Int @default(0)

  @@id([programmeId, workoutId])
}

model Article {
  id        String   @id @default(cuid())
  title     String
  label     String
  content   String
  image     String?
  slug      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reminder {
  id        String   @id @default(cuid())
  workout   Workout? @relation(fields: [workoutId], references: [id])
  workoutId String?

  programme   Programme? @relation(fields: [programmeId], references: [id])
  programmeId String?

  user   User   @relation(fields: [userId], references: [id])
  userId String

  hour   Int
  minute Int
  days   ReminderDay[]
}

enum ReminderDay {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum Difficulty {
  EASY
  INTERMEDIATE
  HARD
}

enum Intensity {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Role {
  USER
  ADMIN
}

enum WorkoutLevel {
  BASIC
  ADVANCED
}

enum Sensors {
  Transversus
  Rectus
  Spinal
  IMU
}
