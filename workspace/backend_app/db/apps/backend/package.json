{
  "name": "@corecount/backend",
  "main": "index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc && node esbuild.mjs",
    "dev": "concurrently -n tsc,dev \"npm run dev:compile\" \"npm run dev:watch\"",
    "dev:watch": "tsx watch src/index.ts",
    "dev:compile": "tsc --watch",
    "lint:write": "eslint --fix src",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "format:write": "prettier --write . --ignore-path ../../.gitignore",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@corecount/dbprisma": "workspace:^",
    "@fastify/cors": "^9.0.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/static": "^7.0.4",
    "@prisma/instrumentation": "^5.15.1",
    "@sentry/node": "8.31.0",
    "@trpc/server": "11.0.0-rc.441",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.0",
    "flat": "^6.0.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "prisma-extension-cache-manager": "^0.3.0",
    "prom-client": "^15.1.2",
    "pug": "^3.0.3",
    "react-quill": "^2.0.0",
    "superjson": "2.2.1",
    "winston": "^3.13.0",
    "winston-loki": "^6.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@corecount/eslint-config": "workspace:*",
    "@corecount/prettier-config": "workspace:*",
    "@corecount/tailwind-config": "workspace:*",
    "@corecount/tsconfig": "workspace:*",
    "@sentry/cli": "^2.32.1",
    "@sentry/esbuild-plugin": "^2.22.7",
    "@swc/core": "^1.6.1",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/luxon": "^3.4.2",
    "concurrently": "^8.2.2",
    "esbuild": "^0.21.5",
    "lint-staged": "^15.2.7",
    "socket.io-client": "^4.7.5",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "zod-prisma-types": "^3.1.8"
  },
  "prettier": "@corecount/prettier-config"
}
