{
  "cli": {
    "version": ">= 12.1.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "20.17.0",
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "http://192.168.1.12:3003",
        "EXPO_PUBLIC_SENTRY": "false",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "develop"
      }
    },
    "preview": {
      "extends": "base",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.corecount.thebarngames.nl",
        "EXPO_PUBLIC_SENTRY": "true",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "preview"
      }
    },
    "production": {
      "extends": "base",
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://api.corecount.thebarngames.nl",
        "EXPO_PUBLIC_SENTRY": "true",
        "EXPO_PUBLIC_SENTRY_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
